<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <!-- Black and gold city at night, darkened on the left behind the clock. -->
    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_city" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shade" />

    <!-- Top bar: brand, tabs, small clock. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="56dp">

        <TextView
            android:id="@+id/brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:fontFamily="@font/cinzel"
            android:letterSpacing="0.3"
            android:text="@string/brand"
            android:textColor="@color/accent"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/tab_bar"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tab_home"
                style="@style/Tab"
                android:text="@string/tab_home" />

            <TextView
                android:id="@+id/tab_apps"
                style="@style/Tab"
                android:text="@string/tab_apps" />

            <TextView
                android:id="@+id/tab_settings"
                style="@style/Tab"
                android:text="@string/tab_settings" />
        </LinearLayout>

        <TextClock
            android:id="@+id/small_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:fontFamily="@font/cormorant_medium"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="@color/accent"
            android:textSize="26sp"
            android:visibility="invisible" />
    </FrameLayout>

    <!-- Home: clock and apps on the left, phone remote on the right. -->
    <FrameLayout
        android:id="@+id/panel_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="64dp"
        android:layout_marginTop="104dp"
        android:layout_marginEnd="56dp"
        android:layout_marginBottom="48dp"
        android:clipChildren="false">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:clipChildren="false"
            android:orientation="vertical">

            <TextClock
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cormorant_light"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:textColor="@color/accent"
                android:textSize="132sp" />

            <View
                android:id="@+id/gold_line"
                android:layout_width="160dp"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/gold_line" />

            <TextClock
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/cormorant_medium"
                android:format12Hour="EEEE · d MMMM"
                android:format24Hour="EEEE · d MMMM"
                android:letterSpacing="0.22"
                android:shadowColor="#FF000000"
                android:shadowDy="1"
                android:shadowRadius="8"
                android:textAllCaps="true"
                android:textColor="@color/gold_dim"
                android:textSize="18sp" />

            <LinearLayout
                android:id="@+id/tiles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:clipChildren="false"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/netflix"
                    android:layout_width="232dp"
                    android:layout_height="130dp"
                    android:background="@drawable/tile_netflix"
                    android:contentDescription="@string/netflix"
                    android:focusable="true"
                    android:foreground="@drawable/tile_ring"
                    android:nextFocusRight="@id/youtube">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.02"
                        android:text="@string/netflix"
                        android:textColor="@color/netflix"
                        android:textSize="38sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/youtube"
                    android:layout_width="232dp"
                    android:layout_height="130dp"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/tile_youtube"
                    android:contentDescription="@string/youtube"
                    android:focusable="true"
                    android:foreground="@drawable/tile_ring"
                    android:nextFocusLeft="@id/netflix">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_play" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/youtube"
                            android:textColor="@color/text"
                            android:textSize="28sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Phone remote QR code. -->
        <LinearLayout
            android:id="@+id/remote_card"
            android:layout_width="232dp"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/glass"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="22dp">

            <ImageView
                android:id="@+id/qr"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:background="@drawable/qr_bg"
                android:padding="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/cinzel"
                android:letterSpacing="0.2"
                android:text="@string/remote_title"
                android:textAllCaps="true"
                android:textColor="@color/accent"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/remote_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/remote_hint"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/panel_apps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="100dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="46dp"
        android:paddingTop="12dp"
        android:paddingEnd="46dp"
        android:paddingBottom="40dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/panel_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clipChildren="false"
        android:orientation="horizontal"
        android:visibility="gone" />
</FrameLayout>
