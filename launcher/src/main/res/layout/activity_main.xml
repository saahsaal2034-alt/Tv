<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <!-- Soft colour glows behind everything. -->
    <View
        android:layout_width="720dp"
        android:layout_height="720dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-260dp"
        android:layout_marginTop="-320dp"
        android:background="@drawable/glow_violet" />

    <View
        android:layout_width="640dp"
        android:layout_height="640dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-240dp"
        android:layout_marginBottom="-300dp"
        android:background="@drawable/glow_blue" />

    <!-- Top bar: brand, tabs, small clock. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="56dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.45"
            android:text="@string/brand"
            android:textColor="@color/accent"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/tab_bar"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tab_home"
                style="@style/Tab"
                android:text="@string/tab_home" />

            <TextView
                android:id="@+id/tab_apps"
                style="@style/Tab"
                android:text="@string/tab_apps" />

            <TextView
                android:id="@+id/tab_settings"
                style="@style/Tab"
                android:text="@string/tab_settings" />
        </LinearLayout>

        <TextClock
            android:id="@+id/small_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:visibility="invisible" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/panel_home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:clipChildren="false"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-thin"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:textColor="@color/text"
            android:textSize="120sp" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:format12Hour="EEEE · d MMMM"
            android:format24Hour="EEEE · d MMMM"
            android:letterSpacing="0.08"
            android:textColor="@color/text_dim"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:clipChildren="false"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/netflix"
                android:layout_width="288dp"
                android:layout_height="162dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/tile"
                android:contentDescription="@string/netflix"
                android:focusable="true"
                android:foreground="@drawable/tile_ring"
                android:nextFocusRight="@id/youtube">

                <ImageView
                    android:id="@+id/netflix_banner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/netflix_fallback"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.04"
                    android:text="@string/netflix"
                    android:textColor="@color/netflix"
                    android:textSize="44sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/youtube"
                android:layout_width="288dp"
                android:layout_height="162dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/tile"
                android:contentDescription="@string/youtube"
                android:focusable="true"
                android:foreground="@drawable/tile_ring"
                android:nextFocusLeft="@id/netflix">

                <ImageView
                    android:id="@+id/youtube_banner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/youtube_fallback"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="37dp"
                        android:src="@drawable/ic_play" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/youtube"
                        android:textColor="@color/text"
                        android:textSize="34sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/panel_apps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="100dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="46dp"
        android:paddingTop="12dp"
        android:paddingEnd="46dp"
        android:paddingBottom="40dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/panel_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clipChildren="false"
        android:orientation="horizontal"
        android:visibility="gone" />

    <!-- Phone remote QR code. -->
    <LinearLayout
        android:id="@+id/remote_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="44dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/remote_title"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/remote_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/remote_hint"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/qr"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/qr_bg"
            android:padding="6dp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
